<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <style>
        *:not(code) {
            font-family: 'Inter';
        }
        body {
            text-rendering: optimizeLegibility;
        }
    </style>

    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <meta name="color-scheme" content="light dark">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="{{ url_for('static', filename='vendor/tailwindcss-browser-4.3.3.js') }}"></script>
    <script defer src="{{ url_for('static', filename='vendor/alpinejs-3.17.5.min.js') }}"></script>
    <title>Bibliove</title>
</head>
<body x-data="{ 
    isDark: localStorage.getItem('theme') === 'dark', 
    isAuthenticated: {{ is_authenticated | tojson }},
    showDeleteModal: false,
    keyToDelete: null,
    deleteConfirmationText: '',
    isDeleting: false,
    confirmDelete() {
        if (this.deleteConfirmationText === 'delete this key' && !this.isDeleting) {
            this.isDeleting = true;
            
            fetch('/keys/delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': document.querySelector('meta[name=csrf-token]').content,
                },
                body: JSON.stringify({
                    key_id: this.keyToDelete
                })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                this.showDeleteModal = false;
                this.deleteConfirmationText = '';
                this.keyToDelete = null;
                this.isDeleting = false;
                
                window.location.reload();
            })
            .catch(error => {
                console.error('Error deleting key:', error);
                this.isDeleting = false;
                alert('Failed to delete key. Please try again.');
            });
        }
    }
}" 
    :class="isDark ? 'bg-[#101010]' : 'bg-neutral-100'"
    class="transition-colors duration-150">
    
    <nav class="p-4 fixed top-0 left-0 right-0 gap-4 sm:gap-8 flex justify-between z-50 border-b transition-colors duration-150"
         :class="isDark ? 'bg-neutral-950 border-b-neutral-800' : 'bg-white border-b-neutral-200'">
        
        <div class="flex gap-8 items-center">
            <a href="/" class="font-black tracking-tight text-xl transition-colors duration-150"
               :class="isDark ? 'text-white' : 'text-black'">
                Bibli<span class="text-orange-600">ove</span>
            </a>

            <div class="flex items-center gap-8">
                <a href="/docs" class="transition-colors duration-150"
                   :class="isDark ? 'text-neutral-200' : 'text-neutral-800'">Docs</a>
                <a href="/pricing" class="transition-colors duration-150"
                   :class="isDark ? 'text-neutral-200' : 'text-neutral-800'">Pricing</a>
                
            </div>
        </div>

        <div class="flex items-center gap-4 sm:gap-6">
            <div class="space-x-2 {{ 'hidden' if is_authenticated else '' }}">
                <a href="/register" class="bg-orange-600 text-sm sm:text-base text-white p-2 rounded-lg shadow-md hover:opacity-90 transition duration-150">Get Started</a>
                <span class="transition-colors sm:inline-block duration-150 hidden"
                      :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">or</span>
                <a href="/login" class="hidden sm:inline-block text-orange-600 hover:opacity-80 transition duration-150">Log In</a>
            </div>
            <a class="{{ 'hidden' if (not is_authenticated) or request.path=='/dashboard' else '' }} border p-1 rounded-md transition-colors duration-150 shadow-md" href="/dashboard"
                   :class="isDark ? 'text-neutral-400 bg-neutral-900 border-neutral-800' : 'text-neutral-500 border-neutral-400 bg-neutral-50'">Dashboard</a>
            <a class="{{ 'hidden' if (not is_authenticated) or request.path!='/dashboard' else '' }} flex items-center" href="/settings">
                <i 
                :class="isDark ? 'text-white' : 'text-neutral-500'"
                class="fas fa-gear transition duration-150 w-4 text-xl">
                </i>
            </a>
            <i class="fas text-xl cursor-pointer w-4 hover:opacity-70 transition-colors duration-150"
               :class="isDark ? 'fa-moon text-white' : 'fa-sun text-neutral-500'"
               @click="isDark = !isDark; localStorage.setItem('theme', isDark ? 'dark' : 'light')">
            </i>
        </div>
    </nav>
    
    <main>
        {% block content %}{% endblock %}
    </main>
    {% if request.path == "/home" %}
        {% include 'footer.jinja' %}
    {% endif %}

    <script>
        const isAuthenticated = "{{ is_authenticated }}" === "True";
    </script>
</body>
</html>