{% extends "base.jinja" %}

{% block content %}

    {% set limit = plan.quota_limit %}
    {% set percent = (user.master_quota / limit) * 100 %}
    {% set bar_color = 'bg-green-500' %}
    {% if percent >= 80 %}
    {% set bar_color = 'bg-red-600' %}
    {% elif percent >= 60 %}
    {% set bar_color = 'bg-orange-600' %}
    {% elif percent >= 40 %}
    {% set bar_color = 'bg-amber-500' %}
    {% endif %}

    <head>
        <style>
            @keyframes fill-bar {
                0% {
                    width: 0;
                }
                100% {
                    width: {{(user.master_quota/ limit ) * 100}}%;
                }
            }
            .progress-bar-content {
                animation: fill-bar 2s forwards;
            }
        </style>
    </head>

    <div class="flex *:flex-1 transition-colors duration-150 h-dvh flex-col sm:flex-row">
        <div :class="isDark ? 'text-white transition duration-150' : 'text-neutral-800'" class="p-8 pt-24 space-y-2">
            <p class="font-black text-3xl">Manage Your API Keys</p>
            <span :class="isDark ? 'text-neutral-400' : 'text-neutral-600'" class="text-xl">{{ email }}</span>
            <span class="{{ 'text-green-500 bg-green-500/20' if plan.name == 'Free' else ' bg-indigo-500/20 text-indigo-500' if plan.name == 'Starter' else 'text-purple-500 bg-purple-500/20' if plan.name == 'Pro' else 'text-orange-600 bg-orange-500/20' }} p-2 text-sm rounded-3xl font-bold">{{ plan.name }}</span>

            <div class="py-4 space-y-2">
                {% for k in user_keys %}
                <div class="p-4 rounded-lg shadow-sm flex items-center *:flex-1 hover:-translate-y-0.5 hover:scale-101 transition duration-150" :class="isDark ? 'bg-neutral-800' : 'bg-white'">
                    <code>{{k.name}}</code>
                    
                    <code :class="isDark ? 'text-neutral-400' : 'text-neutral-500'">{{ k.created_at.strftime('%Y-%m-%d %H:%M:%S') }}</code>
                    <div class="flex justify-end">
                        <button @click="showDeleteModal = true; keyToDelete = '{{k.id}}'">
                            <i class="fas fa-trash text-red-500 hover:opacity-90 transition duration-150 cursor-pointer"></i>
                        </button>
                    </div>
                </div>
                {% endfor %}
                
                {% if can_create %}
                <form method="POST" action="/keys/create" class="mt-2">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" class="rounded-lg w-full p-4 flex items-center justify-center shadow-md transition duration-150 cursor-pointer hover:opacity-90"
                            :class="isDark ? 'bg-neutral-700' : 'bg-neutral-300'">
                        <span class="mr-2">Create a new key</span>
                        <i class="fas fa-plus text-2xl"></i>
                    </button>
                </form>
                {% else %}
                <a href="/upgrade-plan" class="mt-2 rounded-lg w-full p-4 flex items-center justify-center shadow-md transition duration-150"
                   :class="isDark ? 'bg-neutral-700' : 'bg-neutral-300'">
                    <p>
                        {% if is_free %}
                            Upgrade to get more keys and quota
                        {% endif %}
                    </p>
                </a>
                {% endif %}
            </div>
            <section class="pt-6 flex flex-col gap-3">
                <p class="font-black text-2xl">Recent requests</p>
                {% if recent_requests %}
                <ul class="flex flex-col gap-2 max-h-72 overflow-y-auto pr-1">
                    {% for item in recent_requests %}
                    <li class="flex items-center justify-between gap-3 p-3 rounded-lg shadow-sm text-sm"
                        :class="isDark ? 'bg-neutral-800' : 'bg-white'">
                        <code>{{ item.key_name|e }}</code>
                        <span :class="isDark ? 'text-neutral-400' : 'text-neutral-500'">{{ item.created_at.strftime('%b %d, %H:%M') }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">No requests yet. Accepted uploads will show up here.</p>
                {% endif %}
            </section>

            <section class="pt-6 flex flex-col gap-3">
                <p class="font-black text-2xl">Quick start</p>
                <p :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">Replace <code>YOUR_API_KEY</code> with the key you saved when you created it.</p>
                <div class="rounded-lg overflow-hidden shadow-sm border" :class="isDark ? 'border-neutral-800' : 'border-neutral-300'">
                    <div class="flex items-center justify-between px-3 py-2 text-xs transition-colors duration-150"
                         :class="isDark ? 'bg-neutral-800 text-neutral-300' : 'bg-neutral-200 text-neutral-700'">
                        <span>curl</span>
                        <button type="button" id="quickstart-copy" class="px-2 py-1 rounded cursor-pointer transition duration-150 hover:opacity-80"
                                :class="isDark ? 'hover:bg-neutral-700' : 'hover:bg-neutral-300'">Copy</button>
                    </div>
                    <pre id="quickstart-code" class="p-4 text-sm font-mono overflow-x-auto transition-colors duration-150"
                         :class="isDark ? 'bg-neutral-900 text-neutral-100' : 'bg-neutral-50 text-neutral-800'"><code>curl -X POST "{{ request.host_url.rstrip('/')|e }}/extract" \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -F "pdf=@report.pdf"</code></pre>
                </div>
                <a href="/docs" class="text-orange-600 hover:opacity-80 transition duration-150">Full API documentation →</a>
            </section>

        </div>

        <div aria-hidden="true" class="sm:hidden mx-8 border-t border-dashed" :class="isDark ? 'border-neutral-700' : 'border-neutral-300'" style="flex: none"></div>
        <div aria-hidden="true" class="hidden sm:block self-stretch my-8 border-l border-dashed" :class="isDark ? 'border-neutral-700' : 'border-neutral-300'" style="flex: none"></div>

        <div class="sm:pt-24 p-8 min-w-0" :class="isDark ? 'text-white' : 'text-neutral-800'">
            <p class="font-black text-3xl">Monitor Usage</p>
                
            <div class="py-4">
                <p class="text-2xl font-bold">Quota used</p>
                <div :class="isDark ? 'bg-neutral-700' : 'bg-neutral-300'" class="overflow-hidden relative transition duration-150 shadow-sm w-full h-2 my-2 rounded-xl">
                    <div class="absolute progress-bar-content {{bar_color}} top-0 left-0 bottom-0 rounded-xl"></div>
                </div>
                <p class="text-xl font-black" :class="isDark ? 'text-neutral-400' : 'text-neutral-500'">{{ user.master_quota }} / {{ limit }} <span class="font-medium">Pages</span></p>
            </div>

            <hr :class="isDark ? 'border-neutral-800' : 'border-neutral-300'" class="mb-8 transition duration-150 mt-4"/>

            <div class="flex flex-col gap-4 min-w-0">
                <p class="font-black text-3xl">Usage History</p>
                {% if usage_keys %}
                <div class="flex flex-wrap items-end gap-4">
                    <label class="flex flex-col gap-1 w-full sm:w-auto sm:min-w-[11rem]">
                        <span class="text-sm font-semibold" :class="isDark ? 'text-neutral-300' : 'text-neutral-700'">API key</span>
                        <select id="usage-key" class="p-2 rounded-lg border shadow-sm outline-none transition duration-150"
                                :class="isDark ? 'bg-neutral-800 border-neutral-700 text-white' : 'bg-white border-neutral-300 text-black'">
                            {% for key in usage_keys %}
                                <option value="{{ key.id }}">{{ key.name|e }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="flex flex-col gap-1 w-full sm:w-auto sm:min-w-[11rem]">
                        <span class="text-sm font-semibold" :class="isDark ? 'text-neutral-300' : 'text-neutral-700'">Metric</span>
                        <select id="usage-metric" class="p-2 rounded-lg border shadow-sm outline-none transition duration-150"
                                :class="isDark ? 'bg-neutral-800 border-neutral-700 text-white' : 'bg-white border-neutral-300 text-black'">
                            <option value="counts" selected>Requests</option>
                            <option value="pages">Pages scanned</option>
                        </select>
                    </label>
                    <label class="flex flex-col gap-1 w-full sm:w-auto sm:min-w-[11rem]">
                        <span class="text-sm font-semibold" :class="isDark ? 'text-neutral-300' : 'text-neutral-700'">Scope</span>
                        <select id="usage-scope" class="p-2 rounded-lg border shadow-sm outline-none transition duration-150"
                                :class="isDark ? 'bg-neutral-800 border-neutral-700 text-white' : 'bg-white border-neutral-300 text-black'">
                            <option value="day">Per day</option>
                            <option value="month" selected>Per month</option>
                            <option value="year">Per year</option>
                        </select>
                    </label>
                    <label id="usage-month-field" class="hidden w-full sm:w-auto sm:min-w-[11rem]">
                        <span class="block mb-1 text-sm font-semibold" :class="isDark ? 'text-neutral-300' : 'text-neutral-700'">Month</span>
                        <select id="usage-month" class="w-full p-2 rounded-lg border shadow-sm outline-none transition duration-150"
                                :class="isDark ? 'bg-neutral-800 border-neutral-700 text-white' : 'bg-white border-neutral-300 text-black'"></select>
                    </label>
                </div>
                                <p id="usage-total" class="text-sm" :class="isDark ? 'text-neutral-400' : 'text-neutral-600'"></p>
                <div id="usage-frame" class="relative max-w-full min-w-0">
                    <div id="usage-scroll" class="overflow-x-auto rounded-xl border p-4"
                         :class="isDark ? 'bg-neutral-900 border-neutral-800' : 'bg-white border-neutral-300'">
                        <svg id="usage-chart" role="img" aria-label="Accepted requests over time" class="block"></svg>
                    </div>
                    <div id="usage-tooltip" class="hidden pointer-events-none absolute z-10 px-3 py-2 rounded-lg border shadow-lg whitespace-nowrap"
                         :class="isDark ? 'bg-neutral-800 border-neutral-700 text-white' : 'bg-white border-neutral-300 text-black'">
                        <p id="usage-tooltip-when" class="text-xs" :class="isDark ? 'text-neutral-400' : 'text-neutral-500'"></p>
                        <p id="usage-tooltip-count" class="text-base font-bold text-orange-600"></p>
                    </div>
                </div>
                <p class="text-xs" :class="isDark ? 'text-neutral-500' : 'text-neutral-500'">Scroll sideways for earlier periods. Each point counts accepted requests in one period: an hour, a day or a month, depending on the scope.</p>
                <div class="p-4 rounded-xl border shadow-sm flex flex-col gap-1 transition-colors duration-150"
                     :class="isDark ? 'bg-neutral-900 border-neutral-800' : 'bg-white border-neutral-300'">
                    <p class="text-xs uppercase tracking-widest" :class="isDark ? 'text-neutral-500' : 'text-neutral-500'">Overage this period</p>
                    {% if plan.overage_cents_per_page > 0 %}
                    <p class="text-2xl font-black" :class="isDark ? 'text-white' : 'text-black'">{{ overage_pages }} <span class="text-base font-medium">pages</span> · ${{ "%.3f"|format(overage_amount) }}</p>
                    <p class="text-sm" :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">${{ "%.3f"|format(plan.overage_cents_per_page / 100) }} per page above your {{ plan.quota_limit }}-page allowance, billed with your subscription.</p>
                    {% else %}
                    <p class="text-sm" :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">The Free plan stops at its allowance. Upgrade to process pages beyond it.</p>
                    {% endif %}
                </div>
                {% else %}
                <p :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">Create a key to start recording requests.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div x-show="showDeleteModal" 
         x-cloak 
         x-transition.opacity.duration.300ms
         class="absolute flex items-center justify-center inset-0 bg-black/40 z-999"
         @click.away="showDeleteModal = false">
        <div class="shadow-sm p-8 flex flex-col gap-2 rounded-3xl border" 
             :class="isDark ? 'bg-neutral-900 border-neutral-800' : 'bg-neutral-100 border-neutral-300'"
             @click.stop>
            <p class="text-3xl font-bold" :class="isDark ? 'text-neutral-100' : 'text-neutral-800'">Confirm Key Deletion?</p>
            <p :class="isDark ? 'text-neutral-400' : 'text-neutral-500'">If you wish to delete this key, type <strong>delete this key</strong> in the box below</p>
            <p class="text-red-500">This action cannot be undone!</p>
            <input 
                x-model="deleteConfirmationText"
                placeholder="Type here" 
                type="text" 
                class="shadow-md my-2 border w-full p-2 rounded-md focus:border-blue-400 outline-none transition duration-150"
                :class="isDark ? 'bg-neutral-800 text-white placeholder-neutral-400 border-neutral-700' : 'bg-white text-black placeholder-gray-500 border-neutral-300'"
                required
                minlength="1"
            />

            <div class="*:p-2 flex *:flex-1 *:text-xl gap-2 *:cursor-pointer">
                <button @click="confirmDelete()" 
                        class="bg-red-500 text-white rounded-md hover:opacity-90 transition duration-150"
                        :disabled="deleteConfirmationText !== 'delete this key'"
                        :class="deleteConfirmationText !== 'delete this key' ? 'opacity-50 cursor-not-allowed' : ''">
                    Confirm
                </button>
                <button @click="showDeleteModal = false" 
                        :class="isDark ? 'hover:bg-neutral-700 text-neutral-300' : 'hover:bg-neutral-200 text-neutral-600'"
                        class="rounded-md transition duration-150" 
                        type="button">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>

<script>
    (function () {
        const usageKeys = {{ usage_keys|tojson }};
        const keySelect = document.getElementById('usage-key');
        if (!keySelect || !usageKeys.length) {
            return;
        }

        const scopeSelect = document.getElementById('usage-scope');
        const metricSelect = document.getElementById('usage-metric');
        const monthField = document.getElementById('usage-month-field');
        const monthSelect = document.getElementById('usage-month');
        const scroller = document.getElementById('usage-scroll');
        const svg = document.getElementById('usage-chart');
        const totalLabel = document.getElementById('usage-total');
        const tooltip = document.getElementById('usage-tooltip');
        const tooltipWhen = document.getElementById('usage-tooltip-when');
        const tooltipCount = document.getElementById('usage-tooltip-count');
        const frame = document.getElementById('usage-frame');
        const isDark = localStorage.getItem('theme') === 'dark';
        const colors = {
            line: '#ea580c',
            grid: isDark ? '#404040' : '#d4d4d4',
            text: isDark ? '#a3a3a3' : '#525252',
        };
        const LEFT = 44;
        const TOP = 16;
        const PLOT_HEIGHT = 180;
        const BOTTOM = 44;
        const NS = 'http://www.w3.org/2000/svg';

        const scopes = {
            day: {
                step: 40,
                tickEvery: 3,
                window: 'last 24 hours',
                short: (d) => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                full: (d) => d.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }),
            },
            month: {
                step: 40,
                tickEvery: 5,
                short: (d) => d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }),
                full: (d) => d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }),
            },
            year: {
                step: 90,
                tickEvery: 1,
                window: 'last 12 months',
                short: (d) => d.toLocaleDateString(undefined, { month: 'short', year: 'numeric' }),
                full: (d) => d.toLocaleDateString(undefined, { month: 'long', year: 'numeric' }),
            },
        };

        const monthNames = usageKeys[0].series.months;

        function monthTitle(series) {
            return new Date(series.edges[0]).toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
        }

        monthNames.forEach((series, index) => {
            const option = document.createElement('option');
            option.value = String(index);
            option.textContent = monthTitle(series);
            monthSelect.append(option);
        });
        monthSelect.value = String(monthNames.length - 1);

        function node(name, attrs, text) {
            const element = document.createElementNS(NS, name);
            Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, value));
            if (text !== undefined) {
                element.textContent = text;
            }
            return element;
        }

        let activePoints = [];
        let activeUnit = 'request';
        let activeScope = null;
        let guide = null;
        let highlight = null;

        function hideTooltip() {
            tooltip.classList.add('hidden');
            if (guide) {
                guide.setAttribute('visibility', 'hidden');
                highlight.setAttribute('visibility', 'hidden');
            }
        }

        function monotonePath(points) {
            if (points.length === 1) {
                return 'M' + points[0].x + ' ' + points[0].y;
            }

            const last = points.length - 1;
            const dx = [];
            const dy = [];
            const slopes = [];
            for (let i = 0; i < last; i++) {
                dx.push(points[i + 1].x - points[i].x);
                dy.push(points[i + 1].y - points[i].y);
                slopes.push(dy[i] / dx[i]);
            }

            const tangents = new Array(points.length);
            tangents[0] = slopes[0];
            tangents[last] = slopes[last - 1];
            for (let i = 1; i < last; i++) {
                tangents[i] = slopes[i - 1] * slopes[i] <= 0 ? 0 : (slopes[i - 1] + slopes[i]) / 2;
            }

            for (let i = 0; i < last; i++) {
                if (slopes[i] === 0) {
                    tangents[i] = 0;
                    tangents[i + 1] = 0;
                    continue;
                }
                const a = tangents[i] / slopes[i];
                const b = tangents[i + 1] / slopes[i];
                const magnitude = a * a + b * b;
                if (magnitude > 9) {
                    const scale = 3 / Math.sqrt(magnitude);
                    tangents[i] = scale * a * slopes[i];
                    tangents[i + 1] = scale * b * slopes[i];
                }
            }

            let path = 'M' + points[0].x + ' ' + points[0].y;
            for (let i = 0; i < last; i++) {
                const reach = dx[i] / 3;
                const firstX = points[i].x + reach;
                const firstY = points[i].y + tangents[i] * reach;
                const secondX = points[i + 1].x - reach;
                const secondY = points[i + 1].y - tangents[i + 1] * reach;
                path += ' C' + firstX + ' ' + firstY + ' ' + secondX + ' ' + secondY + ' ' + points[i + 1].x + ' ' + points[i + 1].y;
            }
            return path;
        }

        function draw(key, scopeName) {
            const scope = scopes[scopeName];
            const series = scopeName === 'month' ? key.series.months[Number(monthSelect.value)] : key.series[scopeName];
            const counts = metricSelect.value === 'pages' ? series.pages : series.counts;
            const unit = metricSelect.value === 'pages' ? 'page' : 'request';
            const edges = series.edges;
            const max = Math.max(1, ...counts);
            const step = scope.step;
            const width = LEFT + counts.length * step + 16;
            const baseline = TOP + PLOT_HEIGHT;
            const height = baseline + BOTTOM;

            svg.replaceChildren();
            svg.setAttribute('width', width);
            svg.setAttribute('height', height);
            svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);

            [0, Math.ceil(max / 2), max].forEach((value) => {
                const y = baseline - (value / max) * PLOT_HEIGHT;
                svg.append(node('line', { x1: LEFT, x2: width, y1: y, y2: y, stroke: colors.grid, 'stroke-dasharray': value === 0 ? '0' : '4 4' }));
                svg.append(node('text', { x: LEFT - 10, y: y + 4, 'text-anchor': 'end', fill: colors.text, 'font-size': 11 }, String(value)));
            });

            const points = counts.map((count, index) => ({
                x: LEFT + index * step + step / 2,
                y: baseline - (count / max) * PLOT_HEIGHT,
                count: count,
                start: new Date(edges[index]),
                index: index,
            }));

            const line = monotonePath(points);
            const first = points[0];
            const last = points[points.length - 1];
            svg.append(node('path', { d: line + ' L' + last.x + ' ' + baseline + ' L' + first.x + ' ' + baseline + ' Z', fill: colors.line, 'fill-opacity': 0.15, stroke: 'none' }));
            svg.append(node('path', { d: line, fill: 'none', stroke: colors.line, 'stroke-width': 2.5, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));

            points.forEach((point) => {
                if (point.count > 0) {
                    svg.append(node('circle', { cx: point.x, cy: point.y, r: 3, fill: colors.line }));
                }
                if (point.index % scope.tickEvery === 0) {
                    svg.append(node('text', { x: LEFT + point.index * step, y: baseline + 22, fill: colors.text, 'font-size': 11 }, scope.short(point.start)));
                }
            });

            svg.append(node('line', { x1: LEFT, x2: width, y1: baseline, y2: baseline, stroke: colors.text, 'stroke-width': 1 }));

            guide = node('line', { x1: 0, x2: 0, y1: TOP, y2: baseline, stroke: colors.text, 'stroke-dasharray': '3 3', visibility: 'hidden' });
            highlight = node('circle', { cx: 0, cy: 0, r: 5, fill: colors.line, stroke: isDark ? '#171717' : '#ffffff', 'stroke-width': 2, visibility: 'hidden' });
            svg.append(guide, highlight);

            activePoints = points;
            activeScope = scope;
            activeUnit = unit;
            hideTooltip();

            const total = counts.reduce((sum, count) => sum + count, 0);
            const period = scopeName === 'month' ? 'in ' + monthTitle(series) : scope.window;
            totalLabel.textContent = total + ' ' + unit + (total === 1 ? '' : 's') + ' ' + period;
            scroller.scrollLeft = scroller.scrollWidth;
        }

        function pointAt(clientX) {
            const rect = svg.getBoundingClientRect();
            const x = clientX - rect.left;
            if (!activeScope || x < LEFT) {
                return null;
            }
            const index = Math.floor((x - LEFT) / activeScope.step);
            return index >= 0 && index < activePoints.length ? activePoints[index] : null;
        }

        function showTooltip(event) {
            const point = pointAt(event.clientX);
            if (!point) {
                hideTooltip();
                return;
            }

            tooltipWhen.textContent = activeScope.full(point.start);
            tooltipCount.textContent = point.count + ' ' + activeUnit + (point.count === 1 ? '' : 's');
            tooltip.classList.remove('hidden');

            const frameRect = frame.getBoundingClientRect();
            const cursorX = event.clientX - frameRect.left;
            const cursorY = event.clientY - frameRect.top;
            let left = cursorX + 16;
            if (left + tooltip.offsetWidth > frameRect.width - 8) {
                left = cursorX - tooltip.offsetWidth - 16;
            }
            let top = cursorY - tooltip.offsetHeight - 12;
            if (top < 8) {
                top = cursorY + 16;
            }
            top = Math.min(top, frameRect.height - tooltip.offsetHeight - 8);
            tooltip.style.left = Math.max(8, left) + 'px';
            tooltip.style.top = Math.max(8, top) + 'px';

            guide.setAttribute('x1', point.x);
            guide.setAttribute('x2', point.x);
            guide.setAttribute('visibility', 'visible');
            highlight.setAttribute('cx', point.x);
            highlight.setAttribute('cy', point.y);
            highlight.setAttribute('visibility', 'visible');
        }

        function selectedKey() {
            return usageKeys.find((key) => String(key.id) === keySelect.value) || usageKeys[0];
        }

        function refresh() {
            const scopeName = scopeSelect.value;
            monthField.classList.toggle('hidden', scopeName !== 'month');
            draw(selectedKey(), scopeName);
        }

        svg.addEventListener('pointermove', showTooltip);
        svg.addEventListener('pointerleave', hideTooltip);
        scroller.addEventListener('scroll', hideTooltip, { passive: true });
        keySelect.addEventListener('change', refresh);
        scopeSelect.addEventListener('change', refresh);
        metricSelect.addEventListener('change', refresh);
        monthSelect.addEventListener('change', refresh);
        refresh();
    })();
</script>

<script>
    (function () {
        const button = document.getElementById('quickstart-copy');
        const code = document.getElementById('quickstart-code');
        if (!button || !code) {
            return;
        }
        function fallbackCopy(text) {
            const area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.append(area);
            area.select();
            const copied = document.execCommand('copy');
            area.remove();
            return copied;
        }

        button.addEventListener('click', async () => {
            const text = code.textContent;
            let copied = false;
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    copied = true;
                }
            } catch (error) {
                copied = false;
            }
            if (!copied) {
                copied = fallbackCopy(text);
            }
            button.textContent = copied ? 'Copied' : 'Copy failed';
            setTimeout(() => { button.textContent = 'Copy'; }, 1500);
        });
    })();
</script>
{% endblock %}
