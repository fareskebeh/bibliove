{% extends "base.jinja" %}

{% block content %}
<div class="pt-56 flex flex-col gap-32 sm:gap-0 pb-16 sm:pb-0 sm:pt-0 **:transition-colors **:duration-150">
    <div :class="isDark ? 'text-white' : 'text-neutral-800' "
        class="p-4 h-dvh flex gap-4 flex-col sm:flex-row justify-center *:flex-1 *:p-4 sm:*:p-8 items-center">
        <div class="space-y-8 sm:space-y-4">
            <p class="text-5xl font-black ">Turn images + PDF files to plain text with one request</p>
            <p class="text-2xl" :class="isDark ? 'text-neutral-400' : 'text-neutral-600'">My responsive RESTful API will
                provide text extraction and OCR capabilities to your app, with a very minimal cost.</p>
            <a href="{{ '/dashboard' if is_authenticated else '/register' }}"
                class="text-xl p-3 shadow-sm text-white bg-orange-600 rounded-xl">Get Your API Key</a>
        </div>
        <div class="flex flex-col gap-4">

            <div class="flex text-xl gap-4">
                <div :class="isDark ? 'border-neutral-700' : 'border-neutral-400' "
                    class="border p-2 rounded-md bg-yellow-50 text-neutral-800 shadow-sm">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.
                </div>
            </div>

            <div :class="isDark ? 'border-neutral-700 bg-neutral-800' : 'border-neutral-300' "
                class="border rounded-xl shadow-sm overflow-hidden flex flex-col gap-1">
                <div :class="isDark ? 'bg-neutral-900' : 'bg-neutral-200' " class="p-2 flex gap-2 shadow-md justify-end">
                    <div class="w-4 h-4 bg-red-500 rounded-full"></div>
                    <div class="w-4 h-4 bg-amber-500 rounded-full"></div>
                    <div class="w-4 h-4 bg-green-500 rounded-full"></div>
                </div>
                <div class="flex flex-col gap-1 p-2">
                    <code>$ curl -X POST https://api.bibliove.com/extract</code>
                    <code>-H "Authorization: Bearer YOUR_API_KEY"</code>
                    <code>-F "file=@test.pdf"</code>
                </div>
            </div>

            <div class="shadow-sm flex flex-col gap-1 p-2 rounded-lg border font-mono text-sm"
                :class="isDark ? 'bg-neutral-900 border-neutral-700' : 'bg-neutral-50 border-gray-300'">
                <div>
                    <span :class="isDark ? 'text-yellow-400' : 'text-purple-600'">{</span>
                </div>

                <div class="pl-4">
                    <code :class="isDark ? 'text-blue-400' : 'text-blue-600'">"status"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">:</code>
                    <code :class="isDark ? 'text-green-400' : 'text-green-600'">"success"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">,</code>
                </div>

                <div class="pl-4">
                    <code :class="isDark ? 'text-blue-400' : 'text-blue-600'">"data"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">:</code>
                    <code :class="isDark ? 'text-yellow-400' : 'text-purple-600'">{</code>
                </div>

                <div class="pl-8">
                    <code :class="isDark ? 'text-blue-400' : 'text-blue-600'">"filename"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">:</code>
                    <code :class="isDark ? 'text-green-400' : 'text-green-600'">"test.pdf"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">,</code>
                </div>

                <div class="pl-8">
                    <code :class="isDark ? 'text-blue-400' : 'text-blue-600'">"extracted_text"</code>
                    <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">:</code>
                    <code :class="isDark ? 'text-green-400' : 'text-green-600'">"Lorem ipsum dolor sit amet, consectetur
                        adipiscing elit, sed do eiusmod tempor incididunt."</code>
                </div>

                <div class="pl-4">
                    <code :class="isDark ? 'text-yellow-400' : 'text-purple-600'">}</code>
                </div>

                <div>
                    <code :class="isDark ? 'text-yellow-400' : 'text-purple-600'">}</code>
                </div>
            </div>


        </div>



    </div>

    <div class="px-6 py-16 sm:py-24 flex flex-col items-center gap-10" :class="isDark ? 'text-white' : 'text-neutral-800'">
    <p class="text-3xl sm:text-4xl font-black text-center">It even works on images and image PDF files,<br class="hidden sm:block"> no matter the quality</p>

    <div class="w-full max-w-4xl p-6 sm:p-8 rounded-2xl border shadow-sm flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-8"
        :class="isDark ? 'bg-neutral-900 border-neutral-800' : 'bg-white border-neutral-300'">
        <img src="{{ url_for('static', filename='images/lorem-img.png') }}" class="h-24 sm:h-28 w-auto rounded-md shadow-md" alt="Sample scanned page" />

        <svg class="w-8 h-8 rotate-90 sm:rotate-0 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>

        <p class="font-black text-2xl tracking-tight whitespace-nowrap" :class="isDark ? 'text-white' : 'text-black'">
            Bibli<span class="text-orange-600">ove</span>
        </p>

        <svg class="w-8 h-8 rotate-90 sm:rotate-0 text-orange-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>

        <div class="flex flex-col gap-1 p-4 rounded-lg border font-mono text-sm w-full sm:w-auto"
            :class="isDark ? 'bg-neutral-950 border-neutral-800' : 'bg-neutral-50 border-neutral-300'">
            <code :class="isDark ? 'text-gray-500' : 'text-gray-500'">{</code>
            <div class="pl-4">
                <code :class="isDark ? 'text-blue-400' : 'text-blue-600'">"extracted_text"</code>
                <code :class="isDark ? 'text-gray-400' : 'text-gray-600'">:</code>
                <code :class="isDark ? 'text-green-400' : 'text-green-600'">"LOREM IPSUM"</code>
            </div>
            <code :class="isDark ? 'text-gray-500' : 'text-gray-500'">}</code>
        </div>
    </div>
</div>

</div>
{% endblock %}