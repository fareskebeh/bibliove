[Unit]
Description=Bibliove web (gunicorn)
After=network.target redis-server.service postgresql.service

[Service]
WorkingDirectory=/opt/bibliove
EnvironmentFile=/opt/bibliove/.env
ExecStart=/opt/bibliove/venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
User=bibliove

[Install]
WantedBy=multi-user.target
